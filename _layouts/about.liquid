---
layout: default
---
{% comment %}
  Site override of al_folio_core 1.0.15 _layouts/about.liquid.
  Home page in the site's "blueprint" style: a hero with a profile panel, then numbered sections.
  Text lives in _pages/about.md (front matter: hero, profile, focus, videos; body: the About text).
{% endcomment %}
<div class="sz-home">
  <section class="sz-hero">
    <div class="sz-hero-main">
      {% if page.hero.eyebrow %}
        <p class="sz-label">{{ page.hero.eyebrow }}</p>
      {% endif %}
      <h1 class="sz-hero-title">
        {{ site.first_name }}
        <span class="sz-accent">{{ site.last_name }}</span>
      </h1>
      {% if page.hero.lead %}
        <p class="sz-hero-lead">{{ page.hero.lead }}</p>
      {% endif %}
      {% if page.hero.buttons %}
        <div class="sz-actions">
          {% for b in page.hero.buttons %}
            <a
              class="sz-btn{% if forloop.first %} sz-btn-primary{% endif %}"
              href="{% if b.url contains '://' or b.url contains '#' %}{{ b.url }}{% else %}{{ b.url | relative_url }}{% endif %}"
            >
              {{- b.label -}}
            </a>
          {% endfor %}
        </div>
      {% endif %}
      {% if page.hero.chips %}
        <ul class="sz-chips">
          {% for c in page.hero.chips %}
            <li>{{ c }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    {% if page.profile %}
      <aside class="sz-panel" aria-label="Profile">
        <div class="sz-panel-head">
          <span>Profile</span>
          <span>{{ site.url | remove: 'https://' | remove: 'http://' }}</span>
        </div>
        <div class="sz-panel-id">
          {% if page.profile.image %}
            <img
              class="sz-avatar"
              src="{{ 'assets/img/' | append: page.profile.image | relative_url }}"
              alt="{{ site.first_name }} {{ site.last_name }}"
              width="88"
              height="88"
            >
          {% endif %}
          <div>
            <div class="sz-panel-name">
              {{ site.first_name }}
              {{ site.last_name }}
            </div>
            {% if page.profile.role %}
              <div class="sz-panel-role">{{ page.profile.role }}</div>
            {% endif %}
          </div>
        </div>
        {% if page.profile.facts %}
          <dl class="sz-facts">
            {% for f in page.profile.facts %}
              <div class="sz-fact">
                <dt>{{ f.label }}</dt>
                <dd>{{ f.value }}</dd>
              </div>
            {% endfor %}
          </dl>
        {% endif %}
        <div class="sz-panel-foot">Updated {{ site.time | date: '%b %Y' }}</div>
      </aside>
    {% endif %}
  </section>

  {% assign sec = 0 %}

  <section class="sz-section" id="about">
    {% assign sec = sec | plus: 1 %}
    <p class="sz-label sz-rule">
      Sec. {% if sec < 10 %}0{% endif -%}
      {{- sec }} — About
    </p>
    <div class="sz-split">
      <div class="sz-prose">{{ content }}</div>
      {% if page.focus %}
        <div class="sz-grid">
          {% for f in page.focus %}
            <div class="sz-cell">
              <h3>{{ f.title }}</h3>
              <p>{{ f.text }}</p>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>

  {% if page.videos %}
    <section class="sz-section sz-band" id="recent-videos">
      {% assign sec = sec | plus: 1 %}
      <p class="sz-label sz-rule">
        Sec. {% if sec < 10 %}0{% endif -%}
        {{- sec }} — Video
      </p>
      <h2 class="sz-h2">Recent <span class="sz-accent">Videos</span></h2>
      {% for v in page.videos %}
        <figure class="sz-figure">
          <figcaption class="sz-figcap">
            <span
              >Fig. {% if sec < 10 %}0{% endif -%}
              {{- sec }}-{{ forloop.index }} — {{ v.title -}}
            </span>
            <span>
              {{- v.date | date: '%b %d, %Y' -}}
              {%- if v.post %}
                · <a href="{{ v.post | relative_url }}">Notes →</a>
              {%- endif -%}
            </span>
          </figcaption>
          <div class="sz-video">
            <iframe
              src="https://www.youtube.com/embed/{{ v.id }}"
              title="{{ v.title | escape }}"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
        </figure>
      {% endfor %}
    </section>
  {% endif %}

  {% if page.latest_posts and page.latest_posts.enabled %}
    <section class="sz-section" id="latest-posts">
      {% assign sec = sec | plus: 1 %}
      <p class="sz-label sz-rule">
        Sec. {% if sec < 10 %}0{% endif -%}
        {{- sec }} — Writing
      </p>
      <h2 class="sz-h2">
        <a href="{{ '/blog/' | relative_url }}">Latest <span class="sz-accent">Posts</span></a>
      </h2>
      <ul class="sz-rows">
        {% assign post_limit = page.latest_posts.limit | default: 3 %}
        {% for item in site.posts limit: post_limit %}
          {% if item.redirect == blank %}
            {% assign item_url = item.url | relative_url %}
          {% elsif item.redirect contains '://' %}
            {% assign item_url = item.redirect %}
          {% else %}
            {% assign item_url = item.redirect | relative_url %}
          {% endif %}
          <li>
            <span class="sz-row-date">{{ item.date | date: '%b %d, %Y' }}</span>
            <a class="sz-row-main" href="{{ item_url }}">
              <span class="sz-row-title">{{ item.title }}</span>
              {% if item.description -%}
                <span class="sz-row-desc">{{ item.description }}</span>
              {%- endif %}
            </a>
            <span class="sz-row-arrow" aria-hidden="true">→</span>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="sz-section sz-band" id="selected-publications">
      {% assign sec = sec | plus: 1 %}
      <p class="sz-label sz-rule">
        Sec. {% if sec < 10 %}0{% endif -%}
        {{- sec }} — Research
      </p>
      <h2 class="sz-h2">
        <a href="{{ '/publications/' | relative_url }}">Selected <span class="sz-accent">Publications</span></a>
      </h2>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  {% if page.social %}
    <section class="sz-section sz-contact">
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    </section>
  {% endif %}
</div>
